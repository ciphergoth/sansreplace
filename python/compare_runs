# Compare two results directories: for each CSV and algorithm, the new time
# over the old at the points both runs measured, with k >= 10.

import argparse
import pathlib
import statistics

import read_results
from algorithms import ALGORITHMS

def times(csv):
    res = {}
    for item in read_results.read(csv):
        if item.k >= 10:
            res.setdefault(item.alg, {})[(item.n, item.k)] = item.time
    return res

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("old", type=pathlib.Path)
    parser.add_argument("new", type=pathlib.Path)
    args = parser.parse_args()
    for new_csv in sorted(args.new.glob("*.csv")):
        print(f"== {new_csv.stem}")
        old = times(args.old / new_csv.name)
        new = times(new_csv)
        for alg in sorted(new, key=ALGORITHMS.index):
            common = sorted(old.get(alg, {}).keys() & new[alg].keys())
            if not common:
                print(f"{alg:16} new")
                continue
            r = sorted(new[alg][p] / old[alg][p] for p in common)
            print(f"{alg:16} {len(common):4} points"
                f"  new/old median {statistics.median(r):5.2f}"
                f"  10% {r[len(r) // 10]:5.2f}  90% {r[len(r) * 9 // 10]:5.2f}")

if __name__ == '__main__':
    main()
