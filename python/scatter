import argparse
import pathlib

import read_results
from algorithms import ALGORITHMS

topdir = pathlib.Path(__file__).resolve().parent.parent

def parse_args():
    p = argparse.ArgumentParser(allow_abbrev=False,
        description="Scattergram of which algorithms are fastest for which values")
    p.add_argument('csv', type=pathlib.Path,
        help="A results CSV, or a directory holding a CSV per algorithm")
    p.add_argument('--png-output', type=pathlib.Path)
    return p.parse_args()

def main():
    args = parse_args()
    if args.png_output is not None:
        import matplotlib
        matplotlib.use('Agg')
        args.png_output.parent.mkdir(parents=True, exist_ok=True)
    import matplotlib.pyplot as plt
    data = {}
    for item in read_results.read(args.csv):
        # k = 0 can't be shown on a log scale
        if item.k != 0:
            data.setdefault((item.n, item.k), []).append(item)
    points = {}
    for l in data.values():
        winner = min(l, key=lambda it: it.time)
        points.setdefault(winner.alg, []).append(winner)
    markermap = {
        'quadraticreject': '.',
        'rejectionsample': 's',
        'ranksb': 'p',
        'floydf2': 'o',
        'quadraticf2': '*',
        'iterativechoose': '+',
        'reservoirsample': 'D',
        'vitterd': 'v',
        'select': 'x',
        'hsel': 'h',
        'cardchoose': '^',
    }
    fig = plt.figure()
    ax = plt.gca()
    ax.set_xscale('log')
    ax.set_yscale('log')
    ax.set_xlabel("n")
    ax.set_ylabel("k")
    for alg in sorted(points, key=ALGORITHMS.index):
        l = points[alg]
        plt.scatter([it.n for it in l], [it.k for it in l], marker=markermap[alg], label=alg)
    plt.legend()
    if args.png_output is not None:
        plt.savefig(str(args.png_output))
    else:
        plt.show()

if __name__ == '__main__':
    main()
