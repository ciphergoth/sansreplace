# How well do several runs of bench of the same code agree? For each point
# that every run timed, takes its slowest time over its fastest, and counts
# the points where that is over each of a few thresholds: overall, by the
# size of the time, by k, and by algorithm. Then lists the points that agree
# worst, with what each run recorded at each stack position, so that the
# counters can say what the slower run did differently.
#
# --row and --in-order show where one algorithm's disagreements lie: along a
# row of the grid, or at points timed one after another.

import argparse
import csv
import pathlib

THRESHOLDS = [1.03, 1.05, 1.1, 1.2, 1.5]
TIME_BANDS = [("under 100 ns", 1e-7), ("under 10 us", 1e-5), ("under 1 ms", 1e-3),
              ("under 0.05 s", 0.05), ("0.05 s and over", float("inf"))]
K_BANDS = [("k under 1,000", 1000), ("k under 30,000", 30000), ("k under 500,000", 500000),
           ("k 500,000 and over", float("inf"))]

def read(fname):
    "Each point's time and its position rows, in the order timed, and the names of the counters"
    times, positions, counters = {}, {}, []
    with fname.open(newline='') as f:
        for row in csv.reader(f):
            if row[0] == 'info' and row[1] == 'counters':
                counters = row[2].split()
            elif row[0] == 'result':
                times[(int(row[2]), int(row[3]))] = float(row[4])
            elif row[0] == 'position':
                positions.setdefault((int(row[2]), int(row[3])), []).append(row[4:])
    return times, positions, counters

def counts(points):
    return "  ".join(f"{sum(p['ratio'] > t for p in points):6}" for t in THRESHOLDS)

def banded(points, bands, key):
    lo = float("-inf")
    for name, hi in bands:
        inside = [p for p in points if lo <= key(p) < hi]
        print(f"{name:32} {counts(inside)}   of {len(inside)}")
        lo = hi

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("runs", type=pathlib.Path, nargs="+",
        help="Directories that bench --out wrote")
    parser.add_argument("--worst", type=int, default=20,
        help="How many of the points that agree worst to list")
    parser.add_argument("--row", action="append", nargs=2, default=[], metavar=("CASE/ALGORITHM", "K"),
        help="For this algorithm at this k, eg rust-random/hsel 1346269, list each run's time over "
        "the fastest at every n")
    parser.add_argument("--in-order", action="append", default=[], metavar="CASE/ALGORITHM",
        help="For this algorithm, mark each point in the order it was timed with the number of "
        "the run that was slowest, where that run took more than --mark times the fastest")
    parser.add_argument("--mark", type=float, default=1.2)
    args = parser.parse_args()
    names = [sorted(f.relative_to(r) for f in r.glob("*/*.csv")) for r in args.runs]
    for r, n in zip(args.runs[1:], names[1:]):
        assert n == names[0], (args.runs[0], r)

    points, by_name = [], {}
    for name in names[0]:
        runs = [read(r / name) for r in args.runs]
        label = str(name.with_suffix(''))
        here = by_name[label] = []
        for nk in dict.fromkeys(nk for times, _, _ in runs for nk in times):
            if not all(nk in times for times, _, _ in runs):
                print(f"{label}: n = {nk[0]}, k = {nk[1]} was not timed in every run")
                continue
            times = [times[nk] for times, _, _ in runs]
            here.append({'name': label, 'n': nk[0], 'k': nk[1], 'times': times,
                'ratio': max(times) / min(times), 'counters': runs[0][2],
                'positions': [positions[nk] for _, positions, _ in runs]})
        points += here

    print(f"{len(points)} points timed in every run; slowest run over fastest is over:")
    print(f"{'':32} " + "  ".join(f"{t:6}" for t in THRESHOLDS))
    print(f"{'all':32} {counts(points)}")
    print()
    banded(points, TIME_BANDS, lambda p: min(p['times']))
    print()
    banded(points, K_BANDS, lambda p: p['k'])
    print()
    for label, here in sorted(by_name.items(), key=lambda kv: -sum(p['ratio'] > 1.05 for p in kv[1])):
        print(f"{label:32} {counts(here)}   of {len(here)}  worst {max(p['ratio'] for p in here):.2f}")

    for label, k in args.row:
        print(f"\n{label} at k = {k}: each run's time over the fastest, by n")
        row = [p for p in by_name[label] if p['k'] == int(k)]
        for i in range(len(args.runs)):
            print(f"  run {i + 1}: " + " ".join(f"{p['times'][i] / min(p['times']):.2f}" for p in row))

    for label in args.in_order:
        print(f"\n{label}: the run that took over {args.mark} times the fastest, in the order timed")
        print("  " + "".join(
            str(p['times'].index(max(p['times'])) + 1) if p['ratio'] > args.mark else "."
            for p in by_name[label]))

    if args.worst:
        print(f"\nThe {args.worst} points that agree worst. Each position is its offset, the calls "
            "in a batch, the time of a call in the fastest batch, and per call:")
        print("  " + ", ".join(points[0]['counters']))
    for p in sorted(points, key=lambda p: -p['ratio'])[:args.worst]:
        print(f"{p['ratio']:.2f} {p['name']} n = {p['n']}, k = {p['k']}: "
            + ", ".join(f"{t:.4g}" for t in p['times']))
        for i, positions in enumerate(p['positions']):
            for offset, calls, _, fastest, _, _, *counted in positions:
                print(f"  run {i + 1}: {offset:>2} {calls:>8} {float(fastest):.4g}  "
                    + " ".join(f"{float(c):.5g}" for c in counted))

if __name__ == '__main__':
    main()
