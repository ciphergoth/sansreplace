# Pack whole runs of bench into one archive to publish alongside the results
# that python/fastest made from them, which keep only each point's fastest
# run. Each run goes in under runs/ by its directory's name. The archive
# depends only on the runs' contents, so packing the same runs again gives the
# same bytes; prints its SHA-256.

import argparse
import hashlib
import pathlib
import tarfile

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", type=pathlib.Path, required=True, help="The .tar.xz to write")
    parser.add_argument("runs", type=pathlib.Path, nargs="+",
        help="Run directories, each holding the directories bench --out wrote")
    args = parser.parse_args()
    with tarfile.open(args.out, "w:xz") as tar:
        for run in args.runs:
            for f in sorted(run.rglob("*.csv")):
                info = tarfile.TarInfo(str(pathlib.Path("runs") / run.name / f.relative_to(run)))
                info.size = f.stat().st_size
                info.mode = 0o644
                with f.open("rb") as data:
                    tar.addfile(info, data)
    print(hashlib.sha256(args.out.read_bytes()).hexdigest(), args.out)

if __name__ == '__main__':
    main()
