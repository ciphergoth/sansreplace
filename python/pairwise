# Write pairwise.md: for each case, two tables comparing every pair of
# algorithms over the points with k >= 10 that both timed. The first gives the
# row algorithm's worst time as a multiple of the column algorithm's, the
# second its worst excess time per element chosen, each with the n and k where
# it happens. Run as python/pairwise > pairwise.md

import argparse
import pathlib

import read_results
from algorithms import ALGORITHMS

topdir = pathlib.Path(__file__).resolve().parent.parent

CASES = [
    ("cpp-random", "C++, random order"),
    ("cpp-sorted", "C++, sorted order"),
    ("rust-random", "Rust, random order"),
    ("rust-sorted", "Rust, sorted order"),
]

INTRO = """# Pairwise comparisons

Each case has two tables comparing every pair of algorithms in one of the
[benchmark](results.md) cases, over the points with _k_ ≥ 10 that both timed. In the first, the
entry in a row and column is the row algorithm's worst time as a multiple of the column
algorithm's, and the _n_ and _k_ where it happens. An entry below 1× means the row algorithm was
faster at every one of those points. In the second, the entry is the most the row algorithm's
time/_k_ exceeds the column algorithm's, in nanoseconds, and where; a negative entry means the row
algorithm was faster at every point, by at least that much. A ratio is most telling where both
times are small, and a difference where they are large. The quadratic algorithms were only timed
until they became too slow, so their worst cases against the others are worse than shown.

This page is generated by [`python/pairwise`](python/pairwise).
"""

SUPERSCRIPT = str.maketrans("0123456789", "⁰¹²³⁴⁵⁶⁷⁸⁹")

def short(x):
    "An integer to two significant figures, in standard form from 10^4"
    if x < 10000:
        return str(x)
    e = len(str(x)) - 1
    return f"{x / 10**e:.1f}×10{str(e).translate(SUPERSCRIPT)}"

def ratio(x):
    if x < 10:
        return f"{x:.2f}"
    if x < 100:
        return f"{x:.1f}"
    if x < 10000:
        return f"{x:,.0f}"
    return short(round(x))

def nanoseconds(x):
    return ("−" if x < 0 else "+") + ratio(abs(x))

def read_times(case):
    times = {}
    for item in read_results.read(case):
        if item.k >= 10:
            times.setdefault(item.alg, {})[(item.n, item.k)] = item.time
    return times

def table(times, compare, show):
    "The worst of compare(row time, column time, k) for each pair"
    algs = sorted(times, key=ALGORITHMS.index)
    print("| | " + " | ".join(f"`{a}`" for a in algs) + " |")
    print("|---" * (len(algs) + 1) + "|")
    for a in algs:
        cells = []
        for b in algs:
            if a == b:
                cells.append("")
                continue
            worst, (n, k) = max((compare(times[a][p], times[b][p], p[1]), p)
                for p in times[a].keys() & times[b].keys())
            cells.append(f"{show(worst)}<br><sub>n={short(n)}<br>k={short(k)}</sub>")
        print(f"| `{a}` | " + " | ".join(cells) + " |")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--results", type=pathlib.Path,
        default=topdir / "results/latest")
    args = parser.parse_args()
    print(INTRO)
    for name, title in CASES:
        times = read_times(args.results / name)
        print(f"## {title}")
        print()
        print("### Worst ratio of times")
        print()
        table(times, lambda a, b, k: a / b, lambda x: f"{ratio(x)}×")
        print()
        print("### Worst difference in time/_k_ (ns)")
        print()
        table(times, lambda a, b, k: 1E9 * (a - b) / k, nanoseconds)
        print()

if __name__ == '__main__':
    main()
