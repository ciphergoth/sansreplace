# Write pairwise.md: for each case, a table comparing every pair of
# algorithms, giving the row algorithm's worst time as a multiple of the
# column algorithm's, and the n and k where it happens, over the points with
# k >= 10 that both timed. Run as python/pairwise > pairwise.md

import argparse
import pathlib

import read_results
from algorithms import ALGORITHMS

topdir = pathlib.Path(__file__).resolve().parent.parent

CASES = [
    ("cpp-random", "C++, random order"),
    ("cpp-sorted", "C++, sorted order"),
    ("rust-random", "Rust, random order"),
    ("rust-sorted", "Rust, sorted order"),
]

INTRO = """# Pairwise comparisons

Each table compares every pair of algorithms in one of the [benchmark](results.md) cases. The
entry in a row and column is the row algorithm's worst time as a multiple of the column
algorithm's, over the points with _k_ ≥ 10 that both timed, and the _n_ and _k_ where it happens.
An entry below 1× means the row algorithm was faster at every one of those points. The quadratic
algorithms were only timed until they became too slow, so their worst cases against the others
are worse than shown.

This page is generated by [`python/pairwise`](python/pairwise).
"""

SUPERSCRIPT = str.maketrans("0123456789", "⁰¹²³⁴⁵⁶⁷⁸⁹")

def short(x):
    "An integer to two significant figures, in standard form from 10^4"
    if x < 10000:
        return str(x)
    e = len(str(x)) - 1
    return f"{x / 10**e:.1f}×10{str(e).translate(SUPERSCRIPT)}"

def ratio(x):
    if x < 10:
        return f"{x:.2f}"
    if x < 100:
        return f"{x:.1f}"
    if x < 10000:
        return f"{x:,.0f}"
    return short(round(x))

def table(case):
    times = {}
    for item in read_results.read(case):
        if item.k >= 10:
            times.setdefault(item.alg, {})[(item.n, item.k)] = item.time
    algs = sorted(times, key=ALGORITHMS.index)
    print("| | " + " | ".join(f"`{a}`" for a in algs) + " |")
    print("|---" * (len(algs) + 1) + "|")
    for a in algs:
        cells = []
        for b in algs:
            if a == b:
                cells.append("")
                continue
            worst, (n, k) = max((times[a][p] / times[b][p], p)
                for p in times[a].keys() & times[b].keys())
            cells.append(f"{ratio(worst)}×<br><sub>n={short(n)}<br>k={short(k)}</sub>")
        print(f"| `{a}` | " + " | ".join(cells) + " |")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--results", type=pathlib.Path,
        default=topdir / "results/latest")
    args = parser.parse_args()
    print(INTRO)
    for name, title in CASES:
        print(f"## {title}")
        print()
        table(args.results / name)
        print()

if __name__ == '__main__':
    main()
