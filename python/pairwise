# Write pairwise-ratio.md and pairwise-difference.md: for each case, a table
# comparing every pair of algorithms over the points with k >= 10 that both
# timed, giving the row algorithm's worst time as a multiple of the column
# algorithm's, or its worst excess time per element chosen, with the n and k
# where it happens.

import argparse
import pathlib

import read_results
from cases import CASES
from duration import duration
from algorithms import ALGORITHMS

topdir = pathlib.Path(__file__).resolve().parent.parent

COMMON = """Each table compares every pair of algorithms in one of the [benchmark](../../results.md)
cases, over the points with _k_ ≥ 10 that both timed. We stop timing an algorithm at larger values
of _k_ for the same _n_ once a single call takes more than 20 seconds, and at that _k_ and all
larger ones for every later _n_ once that has happened at the same _k_ for two values of _n_. ?
means the row algorithm was not timed at some points where the column algorithm was, so we don't
know its worst case; the smallest such _k_ is given.

This page is generated by [`python/pairwise`](../../python/pairwise).
"""

RATIO_INTRO = """# Pairwise comparisons: ratio of times

The entry in a row and column is the row algorithm's worst time as a multiple of the column
algorithm's, and the _n_ and _k_ where it happens. An entry below 1× means the row algorithm was
faster at every point. A ratio overstates differences where both times are small; the
[difference in time/_k_](pairwise-difference.md) shows those better.

""" + COMMON

DIFFERENCE_INTRO = """# Pairwise comparisons: difference in time/_k_

The entry in a row and column is the most the row algorithm's time/_k_ exceeds the column
algorithm's, per number output, and the _n_ and _k_ where it happens. A negative
entry means the row algorithm was faster at every point, by at least that much. A difference
understates how much slower an algorithm is where both times are small; the
[ratio of times](pairwise-ratio.md) shows those better.

""" + COMMON

SUPERSCRIPT = str.maketrans("0123456789", "⁰¹²³⁴⁵⁶⁷⁸⁹")

def short(x):
    "An integer to two significant figures, in standard form from 10^4"
    if x < 10000:
        return str(x)
    e = len(str(x)) - 1
    return f"{x / 10**e:.1f}×10{str(e).translate(SUPERSCRIPT)}"

def ratio(x):
    if x < 10:
        return f"{x:.2f}"
    if x < 100:
        return f"{x:.1f}"
    if x < 10000:
        return f"{x:,.0f}"
    return short(round(x))

def difference(x):
    return ("−" if x < 0 else "+") + duration(abs(x))

def read_times(case):
    times = {}
    for item in read_results.read(case):
        if item.k >= 10:
            times.setdefault(item.alg, {})[(item.n, item.k)] = item.time
    return times

def table(out, times, compare, show):
    "The worst of compare(row time, column time, k) for each pair"
    algs = sorted(times, key=ALGORITHMS.index)
    print("| | " + " | ".join(f"`{a}`" for a in algs) + " |", file=out)
    print("|---" * (len(algs) + 1) + "|", file=out)
    for a in algs:
        cells = []
        for b in algs:
            if a == b:
                cells.append("")
                continue
            missing = times[b].keys() - times[a].keys()
            if missing:
                k = min(k for _, k in missing)
                cells.append(f"?<br><sub>not timed from<br>k={short(k)}</sub>")
                continue
            worst, (n, k) = max((compare(times[a][p], times[b][p], p[1]), p)
                for p in times[a].keys() & times[b].keys())
            cells.append(f"{show(worst)}<br><sub>n={short(n)}<br>k={short(k)}</sub>")
        print(f"| `{a}` | " + " | ".join(cells) + " |", file=out)

PAGES = [
    ("pairwise-ratio.md", RATIO_INTRO,
        lambda a, b, k: a / b, lambda x: f"{ratio(x)}×"),
    ("pairwise-difference.md", DIFFERENCE_INTRO,
        lambda a, b, k: (a - b) / k, difference),
]

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--results", type=pathlib.Path,
        default=topdir / "results/latest")
    parser.add_argument("--outdir", type=pathlib.Path, default=topdir / "results/latest",
        help="Where to write the pages; their links assume results/latest")
    args = parser.parse_args()
    times = {name: read_times(args.results / name) for name, _ in CASES}
    for fname, intro, compare, show in PAGES:
        with (args.outdir / fname).open("w") as out:
            print(intro, file=out)
            for name, title in CASES:
                print(f"## {title}", file=out)
                print(file=out)
                table(out, times[name], compare, show)
                print(file=out)

if __name__ == '__main__':
    main()
