# Summarise a results directory: how each algorithm compares with the fastest
# of a group, over the points with k >= 10, as in the tables in results.md.

import argparse
import pathlib
import statistics

import read_results
from duration import duration
from algorithms import ALGORITHMS

def read_times(case, max_frac):
    "The time of each algorithm at each point with k >= 10 and k <= max_frac * n"
    times = {}
    for item in read_results.read(case):
        if item.k >= 10 and item.k <= max_frac * item.n:
            times.setdefault((item.n, item.k), {})[item.alg] = item.time
    return times

def compare(times, group, measure):
    """For each algorithm in group, measure(its time, the fastest time in group,
    k) per point"""
    res = {alg: [] for alg in group}
    for point, t in sorted(times.items()):
        present = [alg for alg in group if alg in t]
        best = min(t[alg] for alg in present)
        for alg in present:
            res[alg].append((measure(t[alg], best, point[1]), point))
    return res

def ratios(times, group):
    "For each algorithm in group, its time over the fastest in group, per point"
    return compare(times, group, lambda t, best, k: t / best)

def excesses(times, group):
    """For each algorithm in group, how much its time/k exceeds the fastest in
    group, in seconds, per point"""
    return compare(times, group, lambda t, best, k: (t - best) / k)

def untimed(times, group):
    """For each algorithm in group that was not timed at some points, the
    smallest k of those points"""
    res = {}
    for (n, k), t in times.items():
        for alg in group:
            if alg not in t:
                res[alg] = min(res.get(alg, k), k)
    return res

def short(x):
    "x for a table, in standard form from 10^4"
    if x < 10:
        return f"{x:.2f}"
    if x < 100:
        return f"{x:.1f}"
    if x < 10000:
        return f"{x:,.0f}"
    mantissa, e = f"{x:.1e}".split("e")
    return f"{mantissa}×10<sup>{int(e)}</sup>"

def not_timed(k):
    return f"?<br><sub>not timed from k={short(k)}</sub>"

def markdown(results, group, max_frac):
    "A table of each algorithm's median and worst ratio, with a column per CSV"
    cases = sorted(p for p in results.iterdir() if p.is_dir())
    times = {case: read_times(case, max_frac) for case in cases}
    print("| | " + " | ".join(case.name for case in cases) + " |")
    print("|---" * (len(cases) + 1) + "|")
    for alg in group:
        cells = []
        for case in cases:
            x = [y for y, _ in ratios(times[case], group)[alg]]
            missing = untimed(times[case], group)
            worst = not_timed(missing[alg]) if alg in missing else f"{short(max(x))}×"
            cells.append(f"{short(statistics.median(x))}× / {worst}")
        print(f"| `{alg}` | " + " | ".join(cells) + " |")

def markdown_excess(results, group, max_frac):
    "A table of each algorithm's worst excess time/k, with a column per CSV"
    cases = sorted(p for p in results.iterdir() if p.is_dir())
    times = {case: read_times(case, max_frac) for case in cases}
    print("| | " + " | ".join(case.name for case in cases) + " |")
    print("|---" * (len(cases) + 1) + "|")
    for alg in group:
        cells = []
        for case in cases:
            missing = untimed(times[case], group)
            if alg in missing:
                cells.append(not_timed(missing[alg]))
                continue
            cells.append(duration(max(x for x, _ in excesses(times[case], group)[alg])))
        print(f"| `{alg}` | " + " | ".join(cells) + " |")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("results", type=pathlib.Path)
    parser.add_argument("--group", nargs="+",
        default=["rejectionsample", "floydf2", "hsel", "cardchoose"])
    parser.add_argument("--max-frac", type=float, default=1.0,
        help="Only include points with k <= max_frac * n")
    parser.add_argument("--markdown", action="store_true",
        help="Print a table of median and worst ratios instead")
    parser.add_argument("--markdown-excess", action="store_true",
        help="Print a table of worst excess time/k instead")
    args = parser.parse_args()
    group = sorted(args.group, key=ALGORITHMS.index)
    if args.markdown:
        markdown(args.results, group, args.max_frac)
        return
    if args.markdown_excess:
        markdown_excess(args.results, group, args.max_frac)
        return
    for case in sorted(p for p in args.results.iterdir() if p.is_dir()):
        print(f"== {case.name}")
        for alg, r in ratios(read_times(case, args.max_frac), group).items():
            worst, wpoint = max(r)
            fastest = sum(1 for x, _ in r if x == 1.0)
            print(f"{alg:16} fastest {fastest:4} of {len(r):4}"
                f"  median {statistics.median(x for x, _ in r):5.2f}"
                f"  worst {worst:6.2f} at n={wpoint[0]}, k={wpoint[1]}")

if __name__ == '__main__':
    main()
