# The best algorithms by worst time per number output in each band of k, as
# python/bands.py defines it: a Markdown table per case, the scores of every
# algorithm in every band, or the tables as LaTeX for the paper.

import argparse
import pathlib

import bands
from algorithms import ALGORITHMS
from cases import CASES
from duration import duration

topdir = pathlib.Path(__file__).resolve().parent.parent

def rows(times):
    """For each band: its label, the best algorithms with their scores, the best
    integer-only one if any of those needs floating point, Cardchoose's score
    and the floor"""
    res = []
    for band in bands.BANDS:
        b = bands.in_band(times, band)
        algs = {a for t in b.values() for a in t}
        scores = sorted((bands.score(b, [a]), ALGORITHMS.index(a), a) for a in algs)
        best = [(a, s) for s, _, a in scores if s <= scores[0][0] * bands.TIE]
        integer = None
        if any(a in bands.FLOATING_POINT for a, _ in best):
            integer = next((a, s) for s, _, a in scores if a not in bands.FLOATING_POINT)
        res.append((band, best, integer, bands.score(b, ["cardchoose"]), bands.floor(b)))
    return res

def markdown(results):
    for name, title in CASES:
        print(f"#### {title}\n")
        print("| _k_ from | Best | Best integer-only | `cardchoose` | Floor |")
        print("|---|---|---|---|---|")
        for band, best, integer, cc, fl in rows(bands.read_times(results / name)):
            cells = [bands.band_label(band),
                " = ".join(f"`{a}` {duration(s)}" for a, s in best),
                "" if integer is None else f"`{integer[0]}` {duration(integer[1])}",
                duration(cc), duration(fl)]
            print("| " + " | ".join(cells) + " |")
        print()

def latex(results, outdir):
    for name, title in CASES:
        with (outdir / f"bands-{name}.tex").open("w") as out:
            out.write("\\begin{tabular}{ lllrr }\n"
                "\\(k\\) from & Best & " + bands.latex_stack(["Best", "integer-only"])
                + " & Cardchoose & Floor \\\\\n"
                "\\hline\n")
            for band, best, integer, cc, fl in rows(bands.read_times(results / name)):
                cells = [bands.band_label(band, latex=True),
                    bands.latex_stack([("= " if i else "") + f"{bands.LATEX_NAMES[a]} {bands.latex_duration(s)}"
                        for i, (a, s) in enumerate(best)]),
                    "" if integer is None
                        else f"{bands.LATEX_NAMES[integer[0]]} {bands.latex_duration(integer[1])}",
                    bands.latex_duration(cc), bands.latex_duration(fl)]
                out.write(" & ".join(cells) + " \\\\\n")
            out.write("\\end{tabular}\n")

def every_algorithm(results, out):
    "Every algorithm's score in every band, for each case, as a Markdown page"
    out.write("# Worst time per number output, by band of _k_\n\n"
        "For each algorithm, the most its time per call divided by _k_ reaches at any point with _k_ in\n"
        "the band, over every _n_ timed; the floor is the same for the fastest of all the algorithms\n"
        "at each point. ? marks an algorithm not timed at some points in the band, with the smallest\n"
        "_k_ it was not timed at, because it went over the time limit at a smaller _k_. Generated by\n"
        "[`python/summarise`](../../python/summarise)\n"
        "`--every-algorithm`; see [choosing algorithms](../../choosing.md).\n")
    for name, title in CASES:
        times = bands.read_times(results / name)
        per_band = [bands.in_band(times, band) for band in bands.BANDS]
        out.write(f"\n## {title}\n\n")
        out.write("| | " + " | ".join(f"_k_ from {bands.band_label(band)}" for band in bands.BANDS)
            + " |\n")
        out.write("|---" * (len(bands.BANDS) + 1) + "|\n")
        algs = sorted({a for t in times.values() for a in t}, key=ALGORITHMS.index)
        for alg in algs:
            cells = []
            for b in per_band:
                k = bands.untimed(b, alg)
                if not any(alg in t for t in b.values()):
                    cells.append("not timed")
                elif k is not None:
                    cells.append(f"? from {bands.power(k)}")
                else:
                    cells.append(duration(bands.score(b, [alg])))
            out.write(f"| `{alg}` | " + " | ".join(cells) + " |\n")
        out.write("| floor | " + " | ".join(duration(bands.floor(b)) for b in per_band) + " |\n")

def main():
    parser = argparse.ArgumentParser(description="Print a Markdown table for each case of "
        "the best algorithms in each band of k, by worst time per number output")
    parser.add_argument("--results", type=pathlib.Path, default=topdir / "results/latest")
    parser.add_argument("--latex", type=pathlib.Path,
        help="Write the tables as LaTeX tabulars into this directory instead")
    parser.add_argument("--every-algorithm", type=pathlib.Path,
        help="Write every algorithm's score in every band to this Markdown file instead")
    args = parser.parse_args()
    if args.latex is not None:
        latex(args.results, args.latex)
    elif args.every_algorithm is not None:
        with args.every_algorithm.open("w") as out:
            every_algorithm(args.results, out)
    else:
        markdown(args.results)

if __name__ == '__main__':
    main()
