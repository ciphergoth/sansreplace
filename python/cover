# The best sets of one, two or three algorithms in each case, choosing the
# fastest in the set at each point, by how far the set's worst time per number
# output in a band of k exceeds the band's floor, in the worst band; see
# python/bands.py. For each, and for Cardchoose alone, also the most its score
# exceeds that of the best set of three in any band, in time per number.

import argparse
import collections
import itertools
import pathlib

import bands
from algorithms import ALGORITHMS
from cases import CASES
from duration import duration

topdir = pathlib.Path(__file__).resolve().parent.parent

def ranked_sets(times, size, exclude=()):
    """(worst band over its floor, set) for every set of size algorithms, best
    first; ties go to the set closer to the floors over all the bands"""
    per_band = [bands.in_band(times, band) for band in bands.BANDS]
    floors = [bands.floor(b) for b in per_band]
    algs = sorted({a for t in times.values() for a in t} - set(exclude), key=ALGORITHMS.index)
    ranked = []
    for s in itertools.combinations(algs, size):
        r = [bands.score(b, s) / f for b, f in zip(per_band, floors)]
        ranked.append((max(r), sum(r), s))
    ranked.sort()
    return [(worst, s) for worst, _, s in ranked]

def over(times, s, ref):
    "The most the score of s exceeds that of ref in any band, in seconds per number"
    return max(bands.score(b, s) - bands.score(b, ref)
        for b in (bands.in_band(times, band) for band in bands.BANDS))

# A row of the table: size is 1 to 3, or None for Cardchoose alone; s is None
# for a set no better than the best of one size smaller of the same kind
Row = collections.namedtuple("Row", "size integer s worst extra")

def table(times):
    """For each size, the best set, and the best integer-only set if the best
    needs floating point; then Cardchoose alone. Each with its worst band over
    its floor and the most its score exceeds the best three's"""
    best = {size: ranked_sets(times, size)[0] for size in (1, 2, 3)}
    integer = {size: ranked_sets(times, size, exclude=bands.FLOATING_POINT)[0]
        for size in (1, 2, 3)}
    three = best[3][1]
    rows = []
    for size in (1, 2, 3):
        for is_integer, chosen in [(False, best), (True, integer)]:
            if is_integer and not bands.FLOATING_POINT & set(best[size][1]):
                continue
            worst, s = chosen[size]
            if size > 1 and worst >= chosen[size - 1][0]:
                rows.append(Row(size, is_integer, None, worst, 0))
            else:
                rows.append(Row(size, is_integer, s, worst, over(times, s, three)))
    s = ("cardchoose",)
    rows.append(Row(None, False, s, bands.against_floor(times, s), over(times, s, three)))
    return rows

def markdown_cell(row):
    prefix = "_integer only:_ " if row.integer else ""
    if row.s is None:
        return f"{prefix}no better than {row.size - 1}"
    cell = prefix + " + ".join(f"`{a}`" for a in row.s) + f" {row.worst:.2f}×"
    if row.extra > 0:
        cell += f", +{duration(row.extra)}"
    return cell

def markdown(results):
    print("| | Best one | Best two | Best three | `cardchoose` alone |")
    print("|---|---|---|---|---|")
    for name, title in CASES:
        cells = {size: [] for size in (1, 2, 3, None)}
        for row in table(bands.read_times(results / name)):
            cells[row.size].append(markdown_cell(row))
        print(f"| {title} | " + " | ".join("<br>".join(c) for c in cells.values()) + " |")

def latex(results, out):
    out.write("\\begin{tabular}{ llrr }\n"
        "Set & Algorithms & " + bands.latex_stack(["Against", "floor"]) + " & "
        + bands.latex_stack(["Most over", "best three"]) + " \\\\\n"
        "\\hline\n")
    for name, title in CASES:
        out.write(f"\\multicolumn{{4}}{{l}}{{\\emph{{{title}}}}} \\\\\n")
        for row in table(bands.read_times(results / name)):
            label = "Cardchoose alone" if row.size is None else (
                bands.latex_stack([f"best {row.size}", "integer only"]) if row.integer
                else f"best {row.size}")
            if row.s is None:
                out.write(f"{label} & no better than {row.size - 1} & & \\\\\n")
                continue
            out.write(f"{label} & " + bands.latex_stack([("+ " if i else "") + bands.LATEX_NAMES[a]
                    for i, a in enumerate(row.s)])
                + f" & \\({row.worst:.2f}\\times\\) & "
                + (bands.latex_duration(row.extra) if row.extra > 0 else "") + " \\\\\n")
    out.write("\\end{tabular}\n")

def main():
    parser = argparse.ArgumentParser(description="Print the best sets of up to three "
        "algorithms in each case, by worst time per number output in each band of k")
    parser.add_argument("--results", type=pathlib.Path, default=topdir / "results/latest")
    parser.add_argument("--top", type=int,
        help="Instead, list this many of the best sets of each size in each case")
    parser.add_argument("--latex", type=pathlib.Path,
        help="Write the table as a LaTeX tabular to this file instead")
    args = parser.parse_args()
    if args.top is not None:
        for name, _ in CASES:
            times = bands.read_times(args.results / name)
            print(f"== {name}")
            for size in (1, 2, 3):
                for worst, s in ranked_sets(times, size)[:args.top]:
                    print(f"  {worst:5.2f}x the floor  {' + '.join(s)}")
    elif args.latex is not None:
        with args.latex.open("w") as out:
            latex(args.results, out)
    else:
        markdown(args.results)

if __name__ == '__main__':
    main()
