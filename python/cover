# For each case, the sets of up to --size algorithms that come closest
# to the fastest of all the algorithms at every point with k >= 10, if each
# point uses the fastest algorithm in the set. Sets are ranked by --measure:
# their worst ratio to the fastest, or the most their time/k exceeds the
# fastest's. Each set's worst on the other measure breaks ties, and is shown
# beside it.
#
# Vitter's Algorithm D switches to Algorithm A once n <= 13k, so it is really
# two algorithms. Wherever the best set includes it, the tables also give the
# best set without it.

import argparse
import itertools
import math
import pathlib

import read_results
from cases import CASES
from algorithms import ALGORITHMS
from duration import duration

topdir = pathlib.Path(__file__).resolve().parent.parent

LATEX_NAMES = {
    "quadraticreject": "quadratic rejection",
    "rejectionsample": "set-based rejection",
    "ranksb": "RANKSB",
    "floydf2": "Floyd's F2",
    "quadraticf2": "quadratic F2",
    "iterativechoose": "iterative choosing",
    "reservoirsample": "reservoir sampling",
    "vitterd": "Vitter's D",
    "hiddenshuffle": "Hidden Shuffle",
    "select": "SELECT",
    "hsel": "HSEL",
    "cardchoose": "Cardchoose",
}

def read_times(case):
    times = {}
    for item in read_results.read(case):
        if item.k >= 10:
            times.setdefault((item.n, item.k), {})[item.alg] = item.time
    return times

# For each measure, how badly a set does at one point, given the set's time
# there (the fastest of its algorithms) and the fastest of all algorithms'
MEASURES = {
    "ratio": lambda mine, best, k: mine / best,
    "difference": lambda mine, best, k: (mine - best) / k,
}

def ranked_sets(times, size, measure, exclude=()):
    """(worst on measure, worst on the other measure, set, point where it is
    worst on measure, ratio, difference) for every set of size algorithms, best
    first"""
    other = "difference" if measure == "ratio" else "ratio"
    algs = sorted({a for t in times.values() for a in t} - set(exclude),
        key=ALGORITHMS.index)
    ranked = []
    for s in itertools.combinations(algs, size):
        worst = {}
        for m, f in MEASURES.items():
            worst[m] = max((f(min(t.get(a, math.inf) for a in s), min(t.values()), k), (n, k))
                for (n, k), t in times.items())
        ranked.append((worst[measure][0], worst[other][0], s, worst[measure][1],
            worst["ratio"][0], worst["difference"][0]))
    ranked.sort()
    return ranked

def table_cells(times, max_size, measure):
    "For each size, the best set, and the best without Vitter's D if it differs"
    cells = []
    for size in range(1, max_size + 1):
        best = ranked_sets(times, size, measure)[0]
        cell = [best]
        if "vitterd" in best[2]:
            cell.append(ranked_sets(times, size, measure, exclude=["vitterd"])[0])
        cells.append(cell)
    return cells

def markdown_cell(cell):
    lines = []
    for i, (_, _, s, _, ratio, difference) in enumerate(cell):
        prefix = "_no D:_ " if i > 0 else ""
        lines.append(prefix + " + ".join(f"`{a}`" for a in s)
            + f" {ratio:.2f}× / {duration(difference)}")
    return "<br>".join(lines)

def latex_duration(x):
    "duration(x), with a thin space before the unit"
    d = duration(x)
    number = d.rstrip("nµms")
    return f"{number}\\,{d[len(number):]}"

def latex_rows(title, cells):
    "A row naming the case, then one row per set"
    rows = [f"\\multicolumn{{4}}{{l}}{{\\emph{{{title}}}}}"]
    for size, cell in enumerate(cells, 1):
        for i, (_, _, s, _, ratio, difference) in enumerate(cell):
            label = str(size) if i == 0 else "no D"
            rows.append(f"{label} & " + " + ".join(LATEX_NAMES[a] for a in s)
                + f" & \\({ratio:.2f}\\times\\) & {latex_duration(difference)}")
    return "".join(row + " \\\\\n" for row in rows)

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--results", type=pathlib.Path,
        default=topdir / "results/latest")
    parser.add_argument("--size", type=int, default=3)
    parser.add_argument("--top", type=int, default=5)
    parser.add_argument("--measure", choices=MEASURES, default="ratio",
        help="Rank sets by their worst ratio to the fastest, or worst excess time/k")
    parser.add_argument("--latex", type=pathlib.Path,
        help="Write the table of best sets here, as a LaTeX tabular")
    args = parser.parse_args()
    all_cells = {}
    for name, title in CASES:
        times = read_times(args.results / name)
        print(f"== {name}")
        for size in range(1, args.size + 1):
            for _, _, s, wpoint, ratio, difference in ranked_sets(times, size, args.measure)[:args.top]:
                print(f"  ratio {ratio:5.2f}  difference {duration(difference):>7}"
                    f"  worst {args.measure} at n={wpoint[0]}, k={wpoint[1]}  {' + '.join(s)}")
        all_cells[name] = table_cells(times, args.size, args.measure)
    print()
    print("| | " + " | ".join(f"best {size}" for size in range(1, args.size + 1)) + " |")
    print("|---" * (args.size + 1) + "|")
    for name, title in CASES:
        print(f"| {title} | "
            + " | ".join(markdown_cell(c) for c in all_cells[name]) + " |")
    if args.latex is not None:
        with args.latex.open("w") as out:
            out.write("\\begin{tabular}{ llrr }\n"
                "Size & Algorithms & Ratio & Difference \\\\\n"
                "\\hline\n")
            for name, title in CASES:
                out.write(latex_rows(title, all_cells[name]))
            out.write("\\end{tabular}\n")

if __name__ == '__main__':
    main()
