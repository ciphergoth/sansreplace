import argparse
import atexit
import csv
import datetime
import os
import pathlib
import platform
import shutil
import subprocess
import sys

import asleep
import gitstate
import impls
import machine
import nkvalues
import vmstat
from algorithms import ALGORITHMS, COMPONENTS

topdir = pathlib.Path(__file__).resolve().parent.parent

# What * means in --run; python, the Python implementations, component, the
# parts of the algorithms in cpp/components.cpp, and rand, the Rust rand
# crate's own sampler, can be named too
LANGUAGES = ["cpp", "rust"]
ORDERS = ["random", "sorted"]
# What the other orders hold, and the languages that have them. Of rand's,
# indexsample is rand's index::sample, and the rest are the algorithms it
# chooses between, which need --rust-features rand_internals and a --rust-rand
# that exposes them; rejectionbtree is its rejection sampling as built without
# std, and floydvectorised, floydcontains, inplaceseparate, inplaceshrink and
# inplacecopy are changes to two of them that return the same samples;
# bitvector is Floyd's
# with a bit vector as its set, which rand doesn't have.
OTHER_ORDERS = {
    "component": (COMPONENTS, ["cpp", "rust"]),
    "rand": (["indexsample", "floyd", "inplace", "rejection", "rejectionbtree", "cardchoose",
        "floydvectorised", "floydcontains", "inplaceseparate", "inplaceshrink", "inplacecopy", "bitvector"],
        ["rust"]),
}
# rand's rejection sampling is only for amount < length, and rand never asks
# it for anything else; it can't draw from an empty range at all
NEEDS_K_BELOW_N = {("rand", "rejection"), ("rand", "rejectionbtree")}
# Only these take n of 2^32 or more: rand's index::sample, and those of its
# samplers that, like it, use 64-bit indices there
WIDE = {("rand", alg)
    for alg in ["indexsample", "rejection", "rejectionbtree", "cardchoose", "floydvectorised"]}

# The counters --counters knows by name, each as the TYPE:CONFIG that
# cpp/counters.h describes, and all of which a bare --counters counts.
# Counters are counted together, exactly, so long as there are no more of them
# than the processor offers; the virtual machine the published results are
# timed on offers five. The first three are the kernel's generic events; the
# others are AMD's codes for Zen 4, that machine's processor: requests from
# the level 2 cache's prefetcher for lines that cache already holds, and data
# cache misses that also miss the level 2 cache.
COUNTERS = {"cycles": "0:0", "instructions": "0:1", "branch-misses": "0:5",
    "l2-prefetches": "4:ff70", "l2-misses": "4:0864"}

def counter_list(arg):
    "Parse NAME[=TYPE:CONFIG],... into a list of NAME=TYPE:CONFIG"
    res = []
    for c in arg.split(","):
        if "=" in c:
            res.append(c)
        elif c in COUNTERS:
            res.append(f"{c}={COUNTERS[c]}")
        else:
            raise argparse.ArgumentTypeError(
                f"{c!r} is not NAME=TYPE:CONFIG or one of {', '.join(COUNTERS)}")
    return res

# What --pages has the C library do, through GLIBC_TUNABLES
PAGES = {"4k": None, "2M": "glibc.malloc.hugetlb=2"}

def names_for(order):
    return OTHER_ORDERS[order][0] if order in OTHER_ORDERS else ALGORITHMS

def languages_for(order):
    "The languages that have this order"
    return OTHER_ORDERS[order][1] if order in OTHER_ORDERS else LANGUAGES + ["python"]

def run_spec(spec):
    "Parse LANG/ORDER/ALGORITHM, where any part may be * to mean all of them"
    parts = spec.split("/")
    if len(parts) != 3:
        raise argparse.ArgumentTypeError(f"{spec!r} is not LANG/ORDER/ALGORITHM")
    lang, order, alg = parts
    for part, names in [(lang, LANGUAGES + ["python"]), (order, ORDERS + list(OTHER_ORDERS)),
            (alg, names_for(order))]:
        if part != "*" and part not in names:
            raise argparse.ArgumentTypeError(
                f"{part!r} in {spec!r} is not * or one of {', '.join(names)}")
    if lang != "*" and lang not in languages_for(order):
        raise argparse.ArgumentTypeError(
            f"{spec!r}: {order} is only in {' and '.join(languages_for(order))}")
    return parts

def todo(specs):
    "The (language, order, algorithm) triples the specs name, in the order to time them"
    return [(lang, order, alg) for order in ORDERS + list(OTHER_ORDERS)
        for lang in languages_for(order) for alg in names_for(order)
        if any(all(part == name or (part == "*" and name in names)
            for part, name, names in zip(spec, [lang, order, alg],
                [LANGUAGES, ORDERS, names_for(order)]))
            for spec in specs)]

def fix_freq():
    governors = []
    def reset():
        for p, v in governors:
            p.write_bytes(v)
    atexit.register(reset)
    cpufreq = pathlib.Path('/sys/devices/system/cpu/cpufreq')
    for child in cpufreq.iterdir():
        if not child.name.startswith("policy"):
            continue
        sg = child / "scaling_governor"
        old = sg.read_bytes()
        governors.append((sg, old))
        sg.write_bytes(b"performance")

def launcher(args):
    """What to run a program under, and its environment, which is empty so
    that nothing in ours can change its timings"""
    prefix = []
    env = {}
    if sys.platform == "linux":
        # No address space randomisation
        prefix = [shutil.which("setarch"), platform.machine(), "-R"]
        if args.cpu is not None:
            prefix += [shutil.which("taskset"), "-c", str(args.cpu)]
        if PAGES[args.pages] is not None:
            env["GLIBC_TUNABLES"] = PAGES[args.pages]
    return prefix, env

def time_point(args, cmd, lang, order, alg, n, k):
    """Time a point in a process of its own, and return a row for each stack
    position it was timed at, as cpp/timing.h describes"""
    prefix, env = launcher(args)
    # A point over the per-number limit is off the top of every graph, so one
    # call is enough to say so; but only where a call takes min_time or more,
    # since a shorter one costs the same to time properly
    once_above = min(args.once_above, max(args.per_number_limit * 1e-9 * k, args.min_time))
    cmd = prefix + cmd + ["time", *impls.point_args(order, alg, n, k, impls.point_seed(n, k)),
        "--min-time", str(args.min_time), "--min-batches", str(args.min_batches),
        "--once-above", str(once_above)]
    if lang != "python":
        cmd += ["--positions", str(args.positions)]
        for c in args.counters:
            cmd += ["--counter", c]
    out = subprocess.run(cmd, env=env, check=True, stdout=subprocess.PIPE, text=True).stdout
    return [line.split() for line in out.splitlines()]

def fastest(positions):
    "The time per call at the stack position where it was fastest"
    return min(float(p[3]) for p in positions)

def format_time(t):
    for unit, mul in [("ns", 1E9), ("μs", 1E6), ("ms", 1E3)]:
        if t * mul < 1000:
            return f"{t*mul:.1f}{unit}"
    return f"{t:.1f}s"

def values(args):
    "The (description, n, k) points to time"
    if args.nk is not None:
        points = ((f"n = {n}, k = {k}", n, k) for n, k in args.nk)
    else:
        points = nkvalues.iter_values(args.values)
    return (p for p in points if p[2] <= args.max_k)

def time_one(args, lang, order, alg, csvfile):
    """Time one algorithm at every point, writing its CSV if csvfile isn't None,
    and return its time at each point it timed."""
    if args.fix_freq:
        fix_freq()
    cmd = impls.command(topdir, lang, args.build_dir, args.rust_features, args.rust_rand,
        args.rust_default_build)
    writer = None
    if csvfile is not None:
        csvfile.parent.mkdir(parents=True, exist_ok=True)
        f = csvfile.open("w", newline="")
        writer = csv.writer(f)
        config = {"algorithm": [alg], "build_dir": args.build_dir,
            "counters": ",".join(args.counters), "cpu": args.cpu, "csv": csvfile,
            "fix_freq": args.fix_freq, "language": lang, "max_k": args.max_k,
            "min_batches": args.min_batches, "min_time": args.min_time, "nk": args.nk,
            "once_above": args.once_above, "pages": args.pages,
            "per_number_limit": args.per_number_limit, "positions": args.positions,
            "rust_default_build": args.rust_default_build,
            "rust_features": ",".join(args.rust_features),
            "rust_rand": "" if args.rust_rand is None else gitstate.get(args.rust_rand),
            "sorttype": order, "time_limit": args.time_limit, "values": args.values}
        for k, v in config.items():
            writer.writerow(["config", k, v])
        info = {
            "version": gitstate.get(topdir),
            "donothing_s": fastest(time_point(args, cmd, lang, "donothing", "donothing", 0, 0)),
            "algorithms": [alg],
            "counters": " ".join(c.split("=")[0] for c in args.counters),
            **machine.get(),
            **vmstat.snapshot(),
        }
        for k, v in info.items():
            writer.writerow(["info", k, v])
        f.flush()
    # Once a call takes more than the time limit, skip larger k for the same
    # n. Some algorithms are slow only near k = n, so try again at the next n;
    # but if it goes over the limit at the same k for two different n, skip
    # that k and larger for every n after.
    #
    # The same goes once the time per number output is over its limit and
    # rising with k, as for the quadratic algorithms, and for those that reject
    # draws as k nears n. Where it is over the limit but falling, as at small k
    # for the algorithms whose work goes with n, larger k may yet come under
    # it, so nothing is skipped.
    hit = None   # (n, k) where it last went over a limit
    klim = None  # k from which to skip it for every n
    last = None  # (n, k, time per number) at the last point timed with k > 0
    res = {}
    for descrip, n, k in values(args):
        if ((klim is not None and k >= klim) or (hit is not None and hit[0] == n and k >= hit[1])
                or ((order, alg) in NEEDS_K_BELOW_N and k >= n)
                or (n >= 2**32 and (order, alg) not in WIDE)):
            if writer is not None:
                writer.writerow(["skipped", alg, n, k])
                f.flush()
            continue
        # If the machine sleeps while this is timed, time it again
        while True:
            asleep_before = asleep.total()
            before = vmstat.counters()
            positions = time_point(args, cmd, lang, order, alg, n, k)
            if asleep.total() - asleep_before < asleep.THRESHOLD_S:
                break
            print(f"slept while timing {alg}; timing again in {asleep.SETTLE_S}s", flush=True)
            asleep.settle()
        after = vmstat.counters()
        t = fastest(positions)
        print(f"{descrip}: {format_time(t)}", flush=True)
        if writer is not None:
            writer.writerow(["result", alg, n, k, t])
            writer.writerow(["memory", alg, n, k, *(a - b for a, b in zip(after, before))])
            for p in positions:
                writer.writerow(["position", alg, n, k, *p])
            f.flush()
        res[descrip] = t
        over = None
        if t > args.time_limit:
            over = "the time limit"
        elif k > 0:
            per_number = 1e9 * t / k
            if (per_number > args.per_number_limit and last is not None and last[0] == n
                    and k > last[1] and per_number > last[2]):
                over = "the limit per number, and rising"
            last = (n, k, per_number)
        if over is not None:
            print(f"over {over}: {alg}", flush=True)
            if hit is not None and hit[1] == k:
                klim = k
            hit = (n, k)
    if writer is not None:
        f.close()
    return res

def parse_args():
    p = argparse.ArgumentParser(allow_abbrev=False,
        description="Time the C++ and Rust implementations, each point in a process of "
            "its own, and with --out write OUT/LANG-ORDER/ALGORITHM.csv for each. Stops at "
            "the first failure. On macOS, keeps the machine from idle-sleeping while it runs.")
    p.add_argument("--run", action="append", type=run_spec, metavar="LANG/ORDER/ALGORITHM",
        help="Time only these, where any part may be * to mean all of them, as in "
            "cpp/*/select; may be repeated (default: everything, in C++ and Rust)")
    p.add_argument("--out", type=pathlib.Path, help="Directory to write the CSVs into")
    p.add_argument("--dry-run", action="store_true",
        help="List what would be timed, and stop")
    values = p.add_mutually_exclusive_group()
    values.add_argument("--values", action="append",
        help="Named set of n,k values to time, from python/nkvalues.py; may be repeated "
            "(default: small and fib)")
    values.add_argument("--nk", action="append", nargs=2, type=int, metavar=("N", "K"),
        help="Single n,k value to time; may be repeated")
    # F_40; larger k needs more memory than a 16GB machine has
    p.add_argument("--max-k", type=int, default=102334155,
        help="Skip n,k values with k larger than this (default: %(default)s)")
    p.add_argument("--min-time", type=float, default=0.05,
        help="How long to time each point for at each stack position, in seconds, after "
            "warming up (default: %(default)s)")
    p.add_argument("--min-batches", type=int, default=3,
        help="How many batches of calls to time at least, at each stack position; the "
            "result is the fastest batch (default: %(default)s)")
    p.add_argument("--positions", type=int, default=4,
        help="How many stack positions to time each point at, 16 bytes apart; the result "
            "is the fastest. A point whose call takes --min-time or longer is timed at one "
            "(default: %(default)s)")
    p.add_argument("--once-above", type=float, default=1.0,
        help="A point whose first call takes this long, in seconds, is timed by that call "
            "alone (default: %(default)s)")
    # The hash algorithms take about 20s at the largest k on the r8a.xlarge
    # the published results come from, so a limit of 20s skipped them there
    p.add_argument("--time-limit", type=float, default=30.0,
        help="Once a call takes longer than this, in seconds, skip larger k for the same n, "
            "and if that happens at the same k for two n, that k and larger for every later n "
            "(default: %(default)s)")
    p.add_argument("--per-number-limit", type=float, default=200.0,
        help="Once a call takes more than this per number output, in ns, and more than at "
            "the k before, skip larger k as for --time-limit. A point over it whose call "
            "takes --min-time or more is timed by that call alone (default: %(default)s)")
    p.add_argument("--fix-freq", action="store_true",
        help="Set the CPU frequency governors to performance while timing (Linux, as root)")
    p.add_argument("--cpu", type=int,
        help="Run every point on this CPU, which should be one the kernel keeps other "
            "work off (Linux)")
    p.add_argument("--pages", choices=list(PAGES), default="4k",
        help="The size of page the C library takes memory in; 2M pages come from a pool that "
            "must have been reserved, and need Linux (default: %(default)s)")
    p.add_argument("--counters", nargs="?", type=counter_list, default=[],
        const=counter_list(",".join(COUNTERS)), metavar="NAME[=TYPE:CONFIG],...",
        help="Record these performance counters with each point: any of "
            + ", ".join(COUNTERS) + ", which are for the processor the published results are "
            "timed on, or others given as NAME=TYPE:CONFIG, up to the number the processor "
            "counts at once. With no list, all of those (Linux)")
    p.add_argument("--build-dir", type=pathlib.Path, help="C++ build directory")
    p.add_argument("--rust-features", type=lambda arg: arg.split(","), default=[],
        metavar="FEATURE,...",
        help="Cargo features to build the Rust with, from rust/Cargo.toml: siphash has its "
            "hash tables hash as the standard library's do by default")
    p.add_argument("--rust-rand", type=pathlib.Path, metavar="DIR",
        help="Build the Rust against this checkout of the rand crate rather than the "
            "published one, to time a change to rand with --run rust/rand/indexsample")
    p.add_argument("--rust-default-build", action="store_true",
        help="Build the Rust as Cargo does by default, without the target CPU, function "
            "alignment, single codegen unit and link-time optimisation that we build with")
    args = p.parse_args()
    if args.values is None and args.nk is None:
        args.values = ["small", "fib"]
    if sys.platform != "linux":
        if args.cpu is not None or args.counters or args.pages != "4k":
            p.error("--cpu, --counters and --pages 2M need Linux")
    for n, k in args.nk or []:
        if k > n:
            p.error(f"--nk {n} {k}: k must be at most n")
    return args

def main():
    args = parse_args()
    runs = todo(args.run or [["*", "*", "*"]])
    for lang, order, alg in runs:
        print(f"will time {lang}-{order} {alg}")
    if args.dry_run:
        return
    # Keep the Mac from idle-sleeping until this process exits; a sleep
    # mid-run spoils the points timed across it
    if sys.platform == "darwin":
        subprocess.Popen(["caffeinate", "-i", "-w", str(os.getpid())])
    results = {}
    for lang, order, alg in runs:
        case = f"{lang}-{order}"
        print(f"{datetime.datetime.now():%F %T} starting {case} {alg}", flush=True)
        csvfile = None if args.out is None else args.out / case / f"{alg}.csv"
        results[(case, alg)] = time_one(args, lang, order, alg, csvfile)
        print(f"{datetime.datetime.now():%F %T} finished {case} {alg}", flush=True)
    # Compare the algorithms timed in each case, point by point
    by_point = {}
    for (case, alg), res in results.items():
        for descrip, t in res.items():
            by_point.setdefault((case, descrip), []).append((t, alg))
    for (case, descrip), times in by_point.items():
        if len(times) > 1:
            print(f"\n{case}, {descrip}")
            for t, alg in sorted(times):
                print(f"{format_time(t):>12} {alg}")

if __name__ == '__main__':
    main()
