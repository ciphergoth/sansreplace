"""Fill in the paper's draft record on Zenodo: set its metadata and upload
the PDF that do_build made. It does not publish the record; that is done by
hand on zenodo.org, and cannot be undone.

The draft must already exist, unpublished, holding the DOI that this version
of the paper prints, and either without files or with this same PDF, in which
case only the metadata is set. The token needs the scope deposit:write.
"""

import argparse
import hashlib
import html
import json
import pathlib
import urllib.request

scriptdir = pathlib.Path(__file__).resolve().parent

API = "https://zenodo.org/api/deposit/depositions"
RECORD = 24545118
DOI = f"10.5281/zenodo.{RECORD}"
TAG = "paper_v1"

def metadata():
    abstract = (scriptdir / "abstract.txt").read_text().strip()
    return {
        "title": "Cardchoose: simple, fast sampling without replacement",
        "upload_type": "publication",
        "publication_type": "preprint",
        "publication_date": "2026-11-25",
        "creators": [{"name": "Crowley, Paul", "orcid": "0009-0005-8953-9081"}],
        "description": f"<p>{html.escape(abstract)}</p>",
        "access_right": "open",
        "license": "cc-by-4.0",
        "language": "eng",
        "keywords": ["sampling without replacement", "random sampling",
            "algorithms", "benchmarks"],
        "related_identifiers": [{
            "identifier": f"https://github.com/ciphergoth/sansreplace/tree/{TAG}",
            "relation": "isSupplementedBy",
            "resource_type": "software",
        }],
        "prereserve_doi": True,
    }

def call(token, method, url, data=None, content_type=None):
    "Make a request to Zenodo and return its response, read as JSON"
    headers = {"Authorization": f"Bearer {token}",
        "User-Agent": "sansreplace-zenodo-draft"}
    if content_type is not None:
        headers["Content-Type"] = content_type
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    with urllib.request.urlopen(req) as response:
        return json.load(response)

def main():
    p = argparse.ArgumentParser(description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("token_file", type=pathlib.Path,
        help="A file holding the Zenodo access token")
    args = p.parse_args()
    token = args.token_file.read_text().strip()
    pdf = scriptdir / "build" / "latex.out" / "cardchoose.pdf"

    draft = call(token, "GET", f"{API}/{RECORD}")
    assert not draft["submitted"], "the record is already published"
    assert draft["metadata"]["prereserve_doi"]["doi"] == DOI, draft["metadata"]
    md5 = hashlib.md5(pdf.read_bytes()).hexdigest()
    held = [(f["filename"], f["checksum"]) for f in draft["files"]]
    assert held in ([], [(pdf.name, md5)]), held

    draft = call(token, "PUT", f"{API}/{RECORD}",
        json.dumps({"metadata": metadata()}).encode(), "application/json")
    assert draft["metadata"]["prereserve_doi"]["doi"] == DOI, draft["metadata"]
    print(f"{draft['links']['html']}: metadata set")

    if held == []:
        uploaded = call(token, "PUT", f"{draft['links']['bucket']}/{pdf.name}",
            pdf.read_bytes(), "application/octet-stream")
        assert uploaded["checksum"] == f"md5:{md5}", uploaded
        print(f"{pdf.name} uploaded, {uploaded['size']:,} bytes")
    else:
        print(f"{pdf.name} is already there")

if __name__ == "__main__":
    main()
