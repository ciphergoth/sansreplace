"""Make the tarball of the paper's source to upload to arXiv, as
build/cardchoose-arxiv.tar.gz, and check that it compiles as arXiv will
compile it.

arXiv runs xelatex alone: no biber, and no shell escape for minted to run
Pygments with. So the tarball carries what those would have made: the
bibliography as cardchoose.bbl, and minted's cache of highlighted code, which
the paper is set to read without running anything. It also carries the
figures and tables that do_build generates from the results.

Builds the paper in full in build/arxiv/full to make those, puts the upload
together in build/arxiv/upload, then compiles a copy of the upload in
build/arxiv/check with xelatex alone, and stops unless that gives a paper
with as many pages, every citation and every reference.
"""

import argparse
import pathlib
import re
import shutil
import subprocess
import sys
import tarfile

scriptdir = pathlib.Path(__file__).resolve().parent

MINTED = r"\usepackage[cachedir=build/_minted-cardchoose]{minted}"
CACHE = "_minted-cardchoose"
SOURCES = ["code", "generated"]

def stage(to, minted):
    "Put the paper's source in the directory to, loading minted as given"
    to.mkdir(parents=True)
    tex = (scriptdir / "cardchoose.tex").read_text()
    assert tex.count(MINTED) == 1
    (to / "cardchoose.tex").write_text(tex.replace(MINTED, minted))
    for name in SOURCES:
        shutil.copytree(scriptdir / name, to / name)

def pages(directory):
    "How many pages the paper built in this directory has"
    log = (directory / "cardchoose.log").read_text(errors="replace")
    [n] = re.findall(r"Output written on [^(]*\((\d+) page", log)
    return int(n)

def main():
    argparse.ArgumentParser(description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter).parse_args()
    # Generate the figures and tables, and check the paper builds as usual
    subprocess.run([sys.executable, scriptdir / "do_build"], check=True)
    work = scriptdir / "build" / "arxiv"
    if work.exists():
        shutil.rmtree(work)
    full, upload, check = work / "full", work / "upload", work / "check"

    # A full build, with biber and Pygments, to make the .bbl and a cache
    # holding only what this version of the paper uses
    stage(full, rf"\usepackage[cachedir={CACHE}]{{minted}}")
    shutil.copy(scriptdir / "bib.bib", full)
    subprocess.run(["latexmk", "-xelatex", "-shell-escape", "-interaction=nonstopmode",
        "-halt-on-error", "-file-line-error", "cardchoose.tex"], cwd=full, check=True,
        stdout=subprocess.DEVNULL)

    stage(upload, rf"\usepackage[frozencache,cachedir={CACHE}]{{minted}}")
    shutil.copy(full / "cardchoose.bbl", upload)
    shutil.copytree(full / CACHE, upload / CACHE)

    # Compile it as arXiv will: xelatex alone, until the references settle
    shutil.copytree(upload, check)
    for _ in range(3):
        subprocess.run(["xelatex", "-no-shell-escape", "-interaction=nonstopmode",
            "-halt-on-error", "-file-line-error", "cardchoose.tex"], cwd=check, check=True,
            stdout=subprocess.DEVNULL)
    log = (check / "cardchoose.log").read_text(errors="replace")
    for problem in ["undefined", "Please (re)run Biber", "Rerun to get", "Missing character"]:
        assert problem not in log, f"{problem!r} in {check / 'cardchoose.log'}"
    assert pages(check) == pages(full), (pages(check), pages(full))

    out = scriptdir / "build" / "cardchoose-arxiv.tar.gz"
    with tarfile.open(out, "w:gz") as tar:
        for f in sorted(p for p in upload.rglob("*") if p.is_file()):
            tar.add(f, arcname=str(f.relative_to(upload)))
    print(f"{out}: {out.stat().st_size:,} bytes, {pages(check)} pages; "
        f"compiled without biber or shell escape in {check}")

if __name__ == "__main__":
    main()
