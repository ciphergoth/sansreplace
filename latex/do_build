import argparse
import pathlib
import subprocess
import sys

scriptdir = pathlib.Path(__file__).parent
pythondir = scriptdir.parent / "python"

def parse_args():
    p = argparse.ArgumentParser(allow_abbrev=False)
    return p.parse_args()

def generate():
    "Generate the figures and tables from the results, into generated/"
    generated = scriptdir / "generated"
    generated.mkdir(exist_ok=True)
    for cmd in [
        ["make_plots", "--pgf", generated],
        ["summarise", "--latex", generated],
        ["cover", "--latex", generated / "cover.tex"],
        ["components", "--latex", generated / "components.tex"],
    ]:
        subprocess.run([sys.executable, pythondir / cmd[0], *cmd[1:]], check=True,
            stdout=subprocess.DEVNULL)

def main():
    args = parse_args()
    generate()
    out = scriptdir / "build" / "latex.out"
    # arXiv supports XeLaTeX, but not LuaLaTeX
    subprocess.run(["latexmk", "-xelatex", "-shell-escape",
            "-interaction=nonstopmode", "-halt-on-error", "-file-line-error",
            f"-outdir={out}", "cardchoose.tex"],
        cwd=scriptdir, check=True)

if __name__ == "__main__":
    main()
